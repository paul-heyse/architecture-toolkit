{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:architecture-toolkit:change-set:v1",
  "title": "Typed architecture change commands",
  "description": "The only sanctioned mutation channel (CORE-10).",
  "x-toolkit": {
    "family": "change-set",
    "version": 1,
    "requirements": [
      "CORE-10",
      "CORE-12"
    ]
  },
  "$ref": "#/$defs/ChangeSet",
  "$defs": {
    "AddElement": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "const": "add_element",
          "default": "add_element",
          "title": "Command",
          "type": "string"
        },
        "element": {
          "$ref": "#/$defs/Element"
        }
      },
      "required": [
        "element"
      ],
      "title": "AddElement",
      "type": "object"
    },
    "AddRelationship": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "const": "add_relationship",
          "default": "add_relationship",
          "title": "Command",
          "type": "string"
        },
        "relationship": {
          "$ref": "#/$defs/Relationship"
        }
      },
      "required": [
        "relationship"
      ],
      "title": "AddRelationship",
      "type": "object"
    },
    "Applicability": {
      "enum": [
        "applicable",
        "not_applicable",
        "unknown"
      ],
      "title": "Applicability",
      "type": "string"
    },
    "BehaviorDetail": {
      "additionalProperties": false,
      "properties": {
        "detail_family": {
          "const": "behavior",
          "default": "behavior",
          "title": "Detail Family",
          "type": "string"
        },
        "element_id": {
          "pattern": "^[a-z][a-z0-9_.-]{2,63}$",
          "title": "Element Id",
          "type": "string"
        },
        "nodes": {
          "default": [],
          "items": {
            "$ref": "#/$defs/BehaviorNode"
          },
          "title": "Nodes",
          "type": "array"
        },
        "transitions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/BehaviorTransition"
          },
          "title": "Transitions",
          "type": "array"
        },
        "content_hash": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Hash"
        }
      },
      "required": [
        "element_id"
      ],
      "title": "BehaviorDetail",
      "type": "object"
    },
    "BehaviorNode": {
      "additionalProperties": false,
      "properties": {
        "node_id": {
          "title": "Node Id",
          "type": "string"
        },
        "node_type": {
          "$ref": "#/$defs/BehaviorNodeType"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "ordinal": {
          "minimum": 0,
          "title": "Ordinal",
          "type": "integer"
        },
        "participant_element_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_.-]{2,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Participant Element Id"
        }
      },
      "required": [
        "node_id",
        "node_type",
        "name",
        "ordinal"
      ],
      "title": "BehaviorNode",
      "type": "object"
    },
    "BehaviorNodeType": {
      "description": "The BPMN subset `projections.md` names, stated in the domain rather than the generator.\n\nThe three gateways are distinct members for the reason DATA-30 exists: an exclusive gateway\nand a parallel gateway mean different things, and no edge label recovers the difference.",
      "enum": [
        "task",
        "manual_task",
        "start_event",
        "end_event",
        "intermediate_event",
        "exclusive_gateway",
        "parallel_gateway",
        "inclusive_gateway",
        "subprocess"
      ],
      "title": "BehaviorNodeType",
      "type": "string"
    },
    "BehaviorTransition": {
      "additionalProperties": false,
      "properties": {
        "transition_id": {
          "title": "Transition Id",
          "type": "string"
        },
        "source_node_id": {
          "title": "Source Node Id",
          "type": "string"
        },
        "target_node_id": {
          "title": "Target Node Id",
          "type": "string"
        },
        "guard": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Guard"
        },
        "ordinal": {
          "minimum": 0,
          "title": "Ordinal",
          "type": "integer"
        }
      },
      "required": [
        "transition_id",
        "source_node_id",
        "target_node_id",
        "ordinal"
      ],
      "title": "BehaviorTransition",
      "type": "object"
    },
    "ChangeSet": {
      "additionalProperties": false,
      "properties": {
        "change_set_id": {
          "pattern": "^[a-z][a-z0-9_.-]{2,63}$",
          "title": "Change Set Id",
          "type": "string"
        },
        "model_id": {
          "pattern": "^[a-z][a-z0-9_.-]{2,63}$",
          "title": "Model Id",
          "type": "string"
        },
        "expected_base_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Base Digest"
        },
        "commands": {
          "items": {
            "discriminator": {
              "mapping": {
                "add_element": "#/$defs/AddElement",
                "add_relationship": "#/$defs/AddRelationship",
                "remove_relationship": "#/$defs/RemoveRelationship",
                "rename_element": "#/$defs/RenameElement",
                "retire_element": "#/$defs/RetireElement",
                "update_detail": "#/$defs/UpdateDetail",
                "update_element": "#/$defs/UpdateElement"
              },
              "propertyName": "command"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/AddElement"
              },
              {
                "$ref": "#/$defs/UpdateElement"
              },
              {
                "$ref": "#/$defs/RenameElement"
              },
              {
                "$ref": "#/$defs/RetireElement"
              },
              {
                "$ref": "#/$defs/AddRelationship"
              },
              {
                "$ref": "#/$defs/RemoveRelationship"
              },
              {
                "$ref": "#/$defs/UpdateDetail"
              }
            ]
          },
          "title": "Commands",
          "type": "array"
        }
      },
      "required": [
        "change_set_id",
        "model_id",
        "commands"
      ],
      "title": "ChangeSet",
      "type": "object"
    },
    "ClientAcceptance": {
      "description": "Whether the consumer has agreed. Orthogonal to whether it works.",
      "enum": [
        "not_requested",
        "submitted",
        "accepted",
        "rejected"
      ],
      "title": "ClientAcceptance",
      "type": "string"
    },
    "DataSchemaDetail": {
      "additionalProperties": false,
      "properties": {
        "detail_family": {
          "const": "data_schema",
          "default": "data_schema",
          "title": "Detail Family",
          "type": "string"
        },
        "element_id": {
          "pattern": "^[a-z][a-z0-9_.-]{2,63}$",
          "title": "Element Id",
          "type": "string"
        },
        "fields": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SchemaField"
          },
          "title": "Fields",
          "type": "array"
        },
        "content_hash": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Hash"
        }
      },
      "required": [
        "element_id"
      ],
      "title": "DataSchemaDetail",
      "type": "object"
    },
    "DeliverySemantics": {
      "enum": [
        "at_most_once",
        "at_least_once",
        "exactly_once",
        "unspecified"
      ],
      "title": "DeliverySemantics",
      "type": "string"
    },
    "DeploymentDetail": {
      "additionalProperties": false,
      "properties": {
        "detail_family": {
          "const": "deployment",
          "default": "deployment",
          "title": "Detail Family",
          "type": "string"
        },
        "element_id": {
          "pattern": "^[a-z][a-z0-9_.-]{2,63}$",
          "title": "Element Id",
          "type": "string"
        },
        "environment": {
          "title": "Environment",
          "type": "string"
        },
        "deployment_node_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_.-]{2,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Deployment Node Id"
        },
        "software_instance_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_.-]{2,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Software Instance Id"
        },
        "configuration_artifact_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_.-]{2,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Configuration Artifact Id"
        },
        "content_hash": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Hash"
        }
      },
      "required": [
        "element_id",
        "environment"
      ],
      "title": "DeploymentDetail",
      "type": "object"
    },
    "DesignDisposition": {
      "description": "Where the architectural decision stands. Not a claim about reality.\n\n`CANDIDATE` and `PROPOSED` are distinct because the source list distinguishes them and the\ndifference is load-bearing for option analysis: a candidate is one of several options under\nconsideration, a proposal is the one put forward. Collapsing them would make a toolkit that\ncompares alternatives unable to say which alternative it is recommending.",
      "enum": [
        "candidate",
        "proposed",
        "analytically_feasible",
        "accepted",
        "superseded",
        "rejected"
      ],
      "title": "DesignDisposition",
      "type": "string"
    },
    "Element": {
      "additionalProperties": false,
      "properties": {
        "element_id": {
          "pattern": "^[a-z][a-z0-9_.-]{2,63}$",
          "title": "Element Id",
          "type": "string"
        },
        "model_id": {
          "pattern": "^[a-z][a-z0-9_.-]{2,63}$",
          "title": "Model Id",
          "type": "string"
        },
        "kind_id": {
          "pattern": "^[a-z][a-z0-9]*\\.[a-z][a-z0-9_]*$",
          "title": "Kind Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "lifecycle_state": {
          "$ref": "#/$defs/LifecycleState",
          "default": "active"
        },
        "aliases": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Aliases",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/StatusDimensions",
          "default": {
            "design_disposition": "unknown",
            "implementation_state": "unknown",
            "technical_qualification": "not_qualified",
            "client_acceptance": "not_requested",
            "evidence_review": "unreviewed"
          }
        },
        "detail": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "behavior": "#/$defs/BehaviorDetail",
                  "data_schema": "#/$defs/DataSchemaDetail",
                  "deployment": "#/$defs/DeploymentDetail",
                  "interface": "#/$defs/InterfaceDetail",
                  "requirement": "#/$defs/RequirementDetail"
                },
                "propertyName": "detail_family"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/InterfaceDetail"
                },
                {
                  "$ref": "#/$defs/DeploymentDetail"
                },
                {
                  "$ref": "#/$defs/DataSchemaDetail"
                },
                {
                  "$ref": "#/$defs/BehaviorDetail"
                },
                {
                  "$ref": "#/$defs/RequirementDetail"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        },
        "content_hash": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Hash"
        }
      },
      "required": [
        "element_id",
        "model_id",
        "kind_id",
        "name"
      ],
      "title": "Element",
      "type": "object"
    },
    "EvidenceReview": {
      "description": "How the assertion is known \u2014 the one vocabulary with a source.\n\nOrdered from strongest to weakest grounding, though the enum imposes no ordering: an inferred\nfact and an observed one are both usable, and the difference is exactly what a reviewer needs\nto see.",
      "enum": [
        "unreviewed",
        "observed",
        "client_stated",
        "public_research",
        "inferred",
        "assumption"
      ],
      "title": "EvidenceReview",
      "type": "string"
    },
    "FieldCardinality": {
      "enum": [
        "one",
        "many"
      ],
      "title": "FieldCardinality",
      "type": "string"
    },
    "GapState": {
      "description": "Why a dimension has no ordinary value (DATA-41).\n\nShared across all five dimensions, and asserted disjoint from each of them by\n`tests/unit/test_status.py` \u2014 a future vocabulary that added its own `unknown` would shadow\nthis one and silently change what the union resolves to.",
      "enum": [
        "unknown",
        "not_applicable",
        "withheld",
        "evidence_gap"
      ],
      "title": "GapState",
      "type": "string"
    },
    "ImplementationState": {
      "description": "Whether the thing exists. Independent of whether anyone approved it.",
      "enum": [
        "not_implemented",
        "partially_implemented",
        "implemented",
        "decommissioned"
      ],
      "title": "ImplementationState",
      "type": "string"
    },
    "InteractionMode": {
      "enum": [
        "synchronous",
        "asynchronous",
        "batch",
        "streaming"
      ],
      "title": "InteractionMode",
      "type": "string"
    },
    "InterfaceDetail": {
      "additionalProperties": false,
      "properties": {
        "detail_family": {
          "const": "interface",
          "default": "interface",
          "title": "Detail Family",
          "type": "string"
        },
        "element_id": {
          "pattern": "^[a-z][a-z0-9_.-]{2,63}$",
          "title": "Element Id",
          "type": "string"
        },
        "transport": {
          "$ref": "#/$defs/InterfaceTransport"
        },
        "authentication_description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Authentication Description"
        },
        "request_schema_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_.-]{2,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Schema Id"
        },
        "response_schema_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_.-]{2,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Response Schema Id"
        },
        "delivery_semantics": {
          "$ref": "#/$defs/DeliverySemantics",
          "default": "unspecified"
        },
        "timeout_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timeout Ms"
        },
        "idempotency_description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Idempotency Description"
        },
        "content_hash": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Hash"
        }
      },
      "required": [
        "element_id",
        "transport"
      ],
      "title": "InterfaceDetail",
      "type": "object"
    },
    "InterfaceTransport": {
      "additionalProperties": false,
      "description": "Nested struct, shaped to the Arrow `interface_schema` pinned in `ARCH-TOOL-DATA-001` \u00a73A.\n\nKept nested rather than flattened so W3 maps it to the struct the specification already\nfixes, instead of three loose columns it would then have to reconcile.",
      "properties": {
        "protocol": {
          "title": "Protocol",
          "type": "string"
        },
        "interaction_mode": {
          "$ref": "#/$defs/InteractionMode"
        },
        "serialization": {
          "title": "Serialization",
          "type": "string"
        }
      },
      "required": [
        "protocol",
        "interaction_mode",
        "serialization"
      ],
      "title": "InterfaceTransport",
      "type": "object"
    },
    "KeyMembership": {
      "description": "ERD semantics DATA-30 requires stated, not inferred from a generic edge.",
      "enum": [
        "primary_key",
        "unique_key",
        "foreign_key"
      ],
      "title": "KeyMembership",
      "type": "string"
    },
    "LifecycleState": {
      "description": "Whether the record itself is live. Distinct from every dimension above.\n\nNotion's elements table carries `lifecycle_state` and \u00a76C carries the five dimensions, and\nneither says how they relate. The call taken in W1: this is the record's *existence* and is\nwhat `RetireElement` drives, while the five dimensions are *assessments of a live record*. A\nretired element keeps its last assessment rather than having it erased, because \"this was\naccepted and then retired\" is a different history from \"this was never accepted\".",
      "enum": [
        "active",
        "retired",
        "replaced"
      ],
      "title": "LifecycleState",
      "type": "string"
    },
    "Nullability": {
      "enum": [
        "required",
        "optional"
      ],
      "title": "Nullability",
      "type": "string"
    },
    "Relationship": {
      "additionalProperties": false,
      "description": "Independently identified, because evidence and decisions attach to the relationship itself.\n\nOnly one direction is stored. `registry.py` holds the canonical direction and the inverse\nlabel, and inverse views are derived \u2014 DATA-06 forbids persisting the duplicate.",
      "properties": {
        "relationship_id": {
          "pattern": "^[a-z][a-z0-9_.-]{2,63}$",
          "title": "Relationship Id",
          "type": "string"
        },
        "model_id": {
          "pattern": "^[a-z][a-z0-9_.-]{2,63}$",
          "title": "Model Id",
          "type": "string"
        },
        "relationship_type_id": {
          "pattern": "^[a-z][a-z0-9_.-]{2,63}$",
          "title": "Relationship Type Id",
          "type": "string"
        },
        "source_element_id": {
          "pattern": "^[a-z][a-z0-9_.-]{2,63}$",
          "title": "Source Element Id",
          "type": "string"
        },
        "target_element_id": {
          "pattern": "^[a-z][a-z0-9_.-]{2,63}$",
          "title": "Target Element Id",
          "type": "string"
        },
        "context_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_.-]{2,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Context Id"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "content_hash": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Hash"
        }
      },
      "required": [
        "relationship_id",
        "model_id",
        "relationship_type_id",
        "source_element_id",
        "target_element_id"
      ],
      "title": "Relationship",
      "type": "object"
    },
    "RemoveRelationship": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "const": "remove_relationship",
          "default": "remove_relationship",
          "title": "Command",
          "type": "string"
        },
        "relationship_id": {
          "pattern": "^[a-z][a-z0-9_.-]{2,63}$",
          "title": "Relationship Id",
          "type": "string"
        }
      },
      "required": [
        "relationship_id"
      ],
      "title": "RemoveRelationship",
      "type": "object"
    },
    "RenameElement": {
      "additionalProperties": false,
      "description": "Change the display name and nothing else.\n\n`expected_name` is optimistic concurrency at the field: an author renaming what they believe\nis \"Review request\" should fail rather than overwrite a rename someone else already made.",
      "properties": {
        "command": {
          "const": "rename_element",
          "default": "rename_element",
          "title": "Command",
          "type": "string"
        },
        "element_id": {
          "pattern": "^[a-z][a-z0-9_.-]{2,63}$",
          "title": "Element Id",
          "type": "string"
        },
        "new_name": {
          "minLength": 1,
          "title": "New Name",
          "type": "string"
        },
        "expected_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Name"
        }
      },
      "required": [
        "element_id",
        "new_name"
      ],
      "title": "RenameElement",
      "type": "object"
    },
    "RequirementCategory": {
      "enum": [
        "functional",
        "quality",
        "constraint",
        "regulatory"
      ],
      "title": "RequirementCategory",
      "type": "string"
    },
    "RequirementDetail": {
      "additionalProperties": false,
      "properties": {
        "detail_family": {
          "const": "requirement",
          "default": "requirement",
          "title": "Detail Family",
          "type": "string"
        },
        "element_id": {
          "pattern": "^[a-z][a-z0-9_.-]{2,63}$",
          "title": "Element Id",
