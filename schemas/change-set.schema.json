    "StatusDimensions": {
      "additionalProperties": false,
      "description": "Five independent assessments, each either a vocabulary value or an explicit gap.\n\nThe defaults split on a principle worth stating, because getting it wrong is how a model\nstarts asserting things nobody said. A dimension whose zero state is a genuine *fact* about a\nnew record keeps that zero state: nothing has been qualified, nothing has been requested of a\nclient, nothing has been reviewed. A dimension whose zero state would be a *claim* defaults to\n`UNKNOWN` instead:\n\n* `design_disposition` \u2014 authoring an element is not the same as proposing it. A model\n  frequently documents what already exists, and defaulting to `PROPOSED` would invent an\n  intent.\n* `implementation_state` \u2014 defaulting to `NOT_IMPLEMENTED` asserts the thing does not exist,\n  which is false for every system documented from observation.\n\nDATA-41 is explicit that a value must never be invented to satisfy a structural rule, and a\ndefault is the easiest place for exactly that to happen unnoticed.",
      "properties": {
        "design_disposition": {
          "anyOf": [
            {
              "$ref": "#/$defs/DesignDisposition"
            },
            {
              "$ref": "#/$defs/GapState"
            }
          ],
          "default": "unknown",
          "title": "Design Disposition"
        },
        "implementation_state": {
          "anyOf": [
            {
              "$ref": "#/$defs/ImplementationState"
            },
            {
              "$ref": "#/$defs/GapState"
            }
          ],
          "default": "unknown",
          "title": "Implementation State"
        },
        "technical_qualification": {
          "anyOf": [
            {
              "$ref": "#/$defs/TechnicalQualification"
            },
            {
              "$ref": "#/$defs/GapState"
            }
          ],
          "default": "not_qualified",
          "title": "Technical Qualification"
        },
        "client_acceptance": {
          "anyOf": [
            {
              "$ref": "#/$defs/ClientAcceptance"
            },
            {
              "$ref": "#/$defs/GapState"
            }
          ],
          "default": "not_requested",
          "title": "Client Acceptance"
        },
        "evidence_review": {
          "anyOf": [
            {
              "$ref": "#/$defs/EvidenceReview"
            },
            {
              "$ref": "#/$defs/GapState"
            }
          ],
          "default": "unreviewed",
          "title": "Evidence Review"
        }
      },
      "title": "StatusDimensions",
      "type": "object"
    },
    "TechnicalQualification": {
      "description": "Whether it was tested. `NOT_QUALIFIED` is not a failure.\n\nThe same distinction `domain/engineering.py` draws for tool evidence: a capability nobody has\nqualified yet and a capability that failed qualification are different facts, and merging them\nturns an unexplored option into a rejected one.",
      "enum": [
        "not_qualified",
        "qualified",
        "qualification_failed"
      ],
      "title": "TechnicalQualification",
      "type": "string"
    },
    "UpdateDetail": {
      "additionalProperties": false,
