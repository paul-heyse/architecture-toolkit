{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/architecture-toolkit/requirements.schema.json",
  "title": "Architecture toolkit acceptance index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scope",
    "families",
    "requirements"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "families": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "DATA",
        "PROJ",
        "CORE"
      ],
      "properties": {
        "DATA": {
          "$ref": "#/$defs/family"
        },
        "PROJ": {
          "$ref": "#/$defs/family"
        },
        "CORE": {
          "$ref": "#/$defs/family"
        }
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/requirement"
      },
      "minItems": 169,
      "maxItems": 169
    }
  },
  "$defs": {
    "family": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_spec_id",
        "contract"
      ],
      "properties": {
        "source_spec_id": {
          "type": "string",
          "minLength": 1
        },
        "contract": {
          "type": "string",
          "pattern": "^docs/contracts/.+\\\\.md$"
        }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "statement",
        "contract_ref",
        "implementation_areas",
        "verification"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(DATA|PROJ|CORE)-[0-9]{2}$"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "contract_ref": {
          "type": "string",
          "minLength": 1
        },
        "implementation_areas": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "verification": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    }
  }
}
