{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:architecture-toolkit:qualification-evidence:v1",
  "title": "Architecture toolkit qualification evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "toolkit_commit",
    "platform",
    "python",
    "lock_digest",
    "tests"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "toolkit_commit": {
      "type": "string",
      "minLength": 7
    },
    "platform": {
      "type": "string",
      "minLength": 1
    },
    "python": {
      "type": "string",
      "minLength": 1
    },
    "lock_digest": {
      "type": "string",
      "minLength": 1
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "tests": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/testEvidence"
      }
    }
  },
  "$defs": {
    "testEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "requirements",
        "outcome"
      ],
      "properties": {
        "node_id": {
          "type": "string",
          "minLength": 1
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(DATA|PROJ|CORE)-[0-9]{2}$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "outcome": {
          "enum": [
            "passed",
            "failed",
            "skipped",
            "xfailed",
            "xpassed",
            "error"
          ]
        },
        "duration_seconds": {
          "type": "number",
          "minimum": 0
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
